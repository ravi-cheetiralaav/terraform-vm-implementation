# Example Terraform Variables File for Windows VM with Azure Disk Encryption
# Copy this file to terraform.tfvars and modify the values as needed

# Core Infrastructure
resource_group_name = "rg-windows-vm-ade-test"
location           = "Australia East"

# Windows VM Configuration
admin_username     = "winadmin"
vm_size           = "Standard_D2s_v3"
disk_storage_type = "Premium_LRS"

# Disk Sizes (GB)
os_disk_size_gb   = 127
data_disk_size_gb = 100

# Security (Optional - for enhanced security, specify your IP range)
# allowed_rdp_source_cidr = "203.0.113.0/24"  # Replace with your IP range

# Tags
environment = "Testing"
purpose     = "Windows VM with Azure Disk Encryption Demo"